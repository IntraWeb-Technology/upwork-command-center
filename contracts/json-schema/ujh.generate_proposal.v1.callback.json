        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "INVALID_INPUT",
                "UPSTREAM_UNAVAILABLE",
                "MODEL_ERROR",
                "MODEL_OUTPUT_INVALID",
                "TIMEOUT",
                "INTERNAL"
              ]
            },
            "stage": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "input",
                    "config",
                    "strategy",
                    "writer",
                    "validation"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "retryable": {
              "type": "boolean"
            }
          },
          "required": [
            "code",
            "stage",
            "message",
            "retryable"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "contract",
        "run_id",
        "callback_token",
        "completed_at",
        "execution_ref",
        "status",
        "error"
      ],
      "additionalProperties": false
    }
  ]
